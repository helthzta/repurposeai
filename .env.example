# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for the OAuth redirect + login flow)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio key for Gemini (video analysis, scripts, insights)
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=

# Replicate — hosts bytedance/seedance-2.0-fast (https://replicate.com/bytedance/seedance-2.0-fast)
REPLICATE_API_TOKEN=

# Set to "true" to short-circuit video generation to a canned "completed"
# result instead of calling Seedance — lets you test the full pipeline before
# you have a Replicate token. See SETUP.md.
MOCK_PROVIDERS=true
