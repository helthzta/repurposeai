# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for the OAuth redirect + login flow)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio key for Gemini (video analysis, scripts, insights)
GEMINI_API_KEY=
# Optional override, defaults to gemini-2.5-flash
GEMINI_MODEL=

# OpenRouter — routes to bytedance/seedance-2.5 (https://openrouter.ai/bytedance/seedance-2.5)
OPENROUTER_API_KEY=

# Set to "true" to short-circuit video generation to a canned "completed"
# result instead of calling Seedance — lets you test the full pipeline before
# you have an OpenRouter key. See SETUP.md.
MOCK_PROVIDERS=true

# Dodo Payments (Starter/Pro billing — one-time payment per 30-day period, not a Dodo
# subscription; see SETUP.md §9). Get the API key from Developer -> API in the Dodo dashboard.
DODO_PAYMENTS_API_KEY=
# "test_mode" or "live_mode" — always start on test_mode.
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Populated by `npm run setup:dodo` — do not set these by hand.
DODO_STARTER_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=

